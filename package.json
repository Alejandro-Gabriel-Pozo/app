{
  "name": "reservations-api",
  "version": "1.0.1",
  "description": "Sistema de reservas multi-recurso (cabinas, mesas, spa, tours)",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "rm -rf dist && tsc && cp src/db/schema.sql dist/db/schema.sql && cp src/db/platform.schema.sql dist/db/platform.schema.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate:tenants": "tsx src/scripts/migrate-tenants.ts",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/autocannon": "^7.12.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.7.4",
    "@types/pg": "^8.11.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^3.0.0",
    "autocannon": "^8.0.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.0.0",
    "jscpd": "^5.0.15",
    "patch-package": "^8.0.1",
    "ts-prune": "^0.10.3",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@arcasdk/core": "^2.0.0",
    "@arcasdk/pdf": "^0.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "luxon": "^3.7.2",
    "pg": "^8.13.0",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.7.0",
    "zod": "^3.24.0"
  },
  "overrides": {
    "puppeteer": "^25.8.0"
  }
}
