# .env.example -- Wave 7 (17/09/2026, D-15/P-11, plan de ejecución integral)
#
# Hasta este bloque, el backend no se podía levantar desde una copia local
# del repo sin adivinar qué variables hacían falta (F11-10) -- la única
# fuente de verdad era `render.yaml`, que documenta producción, no un
# arranque local. Este archivo es la contraparte: copiá a `.env`, completá
# los valores REQUERIDOS y corré `npm run dev` (usa `dotenv`/tu propio
# mecanismo para cargarlo -- este repo no impone uno).
#
# La lista completa y el porqué de cada una vive en el docblock de
# `src/config/env.ts` -- ese es el punto único de lectura real. Este
# archivo es solo la plantilla, no la duplica.

# -----------------------------------------------------------------------
# REQUERIDAS -- el proceso no arranca sin esto
# -----------------------------------------------------------------------

# BD central de plataforma (identities, businesses, roles). Postgres real
# (Neon u otro) -- ver docs/conocimiento/runbook-deploy-render.md.
PLATFORM_DATABASE_URL=postgres://user:pass@localhost:5432/platform

# Firma los JWT de sesión de staff/portal cliente. Mínimo 32 caracteres.
JWT_SECRET=cambiame-por-un-secreto-real-de-al-menos-32-caracteres

# Firma los JWT de superadmin (distinto de JWT_SECRET a propósito -- ver
# docs/conocimiento/runbook-rotacion-db-encryption-key.md). Mínimo 32.
PLATFORM_JWT_SECRET=cambiame-tambien-al-menos-32-caracteres

# Cifra las connection strings de tenant guardadas en la BD central
# (AES-256-GCM). 32 bytes en hex (64 caracteres).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=

# -----------------------------------------------------------------------
# OPCIONALES -- el proceso arranca sin esto, pero degrada una capacidad
# -----------------------------------------------------------------------

NODE_ENV=development
PORT=3000
# Dejar SIN DESCOMENTAR salvo que quieras pisar el default -- `getLogLevel()`
# solo trata `undefined` como "no seteada" (`??`), no `''`. Una línea
# `LOG_LEVEL=` vacía (var seteada, valor vacío) pasa un string vacío a
# pino(), que TIRA al importar logger.ts ("default level: must be included
# in custom levels") -- el proceso ni arranca. Mismo motivo por el que
# CORS_ORIGIN de acá abajo también queda comentada.
# LOG_LEVEL=debug

# 'true' fuerza SSL con rejectUnauthorized -- requerido contra Neon en
# producción, normalmente innecesario en Postgres local.
NEON_SSL=false

# Dominio del frontend -- CORS + base de links de mail/dead-letter.
# Sin setear (comentada, no vacía -- mismo motivo que LOG_LEVEL arriba: una
# var seteada a '' es distinta de no seteada, y degrada CORS/los links en
# vez de caer al default real): CORS abierto en dev ('*'),
# http://localhost:3000 como base de links. En producción, false si no
# está seteada (ver src/app.ts).
# CORS_ORIGIN=http://localhost:3000

DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000
# D-20 sub-bloque 4 (17/09/2026) -- valor generoso a propósito, decisión
# explícita del dueño hasta que D-17/F12-06 aterriquen (Wave 10). Ver
# docblock de getDbStatementTimeoutMs() en src/config/env.ts.
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
MAX_TENANT_POOLS=200
HEALTH_DB_TTL_MS=30000
HEALTH_DB_FAIL_TTL_MS=5000

# Bloque 4 (23/09/2026, docs/diseno-invoice-retry-reverse-window-guard-
# 2026-09-23.md §3.4) -- umbral de vencimiento del InvoicePendingExpiryWorker,
# en milisegundos. Ver docblock de getInvoicePendingExpiryThresholdMs() en
# src/config/env.ts.
INVOICE_PENDING_EXPIRY_THRESHOLD_MS=600000

# Ventana de un token de sesión (formato "24h", "30m", etc.).
JWT_EXPIRES_IN=24h

# Clave anterior durante una ventana de rotación de DB_ENCRYPTION_KEY
# (SEC-ROT-001) -- vacía fuera de una rotación activa.
DB_ENCRYPTION_KEY_OLD=

# Bootstrap de superadmin sin fila en platform.schema.sql (fail-closed si
# faltan -- 503 PLATFORM_AUTH_NOT_CONFIGURED).
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Aprovisionamiento automático de tenant DB vía Neon (src/platform/
# neon-provisioning.ts). Sin esto, el alta de negocio queda PENDING
# (fail-open) hasta activarlo a mano con POST /api/admin/set-tenant-url.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_TEMPLATE_BRANCH_ID=

# Envío de mail transaccional (Resend). Sin esto, NoopEmailSender
# (fail-open, loguea en vez de mandar).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Login con Google (staff). Sin esto, ese camino falla con un error claro,
# el login con email+password sigue andando.
GOOGLE_CLIENT_ID=

# Observabilidad de errores (Sentry). Sin esto, no se reportan errores a
# un servicio externo -- los logs locales siguen funcionando.
SENTRY_DSN=

# Legado -- solo lo usa `checkDatabaseHealth()` cuando se llama sin un
# SqlClient explícito (tests/scripts). No hace falta en el server real.
DATABASE_URL=
