{
  "name": "reservations-api",
  "version": "1.0.0",
  "description": "Sistema de reservas multi-recurso (cabinas, mesas, spa, tours)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "npm run build && node dist/server.js",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "psql $DATABASE_URL -f src/db/schema.sql",
    "db:migrate:local": "psql postgresql://localhost/reservations_dev -f src/db/schema.sql"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.0",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.7.0",
    "zod": "^3.24.0"
  }
}
